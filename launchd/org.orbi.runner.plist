<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- One launchd agent per Runner instance: the plist is the
         .service and the .timer in one (StartInterval mirrors the
         systemd OnCalendar=*-*-* *:00/5 five-minute tick). The
         ORBI_* placeholders are substituted at install time by
         `orbi install-units`; the drift check re-renders this
         template and compares the canonical plist form, so key order
         and whitespace in the installed XML never fabricate drift. -->
    <key>Label</key>
    <string>{{ORBI_LABEL}}</string>
    <key>WorkingDirectory</key>
    <string>{{ORBI_REPO_DIR}}</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <!-- Mirrors the systemd EnvironmentFile=- contract: the
           optional env file carries the provider keys OUTSIDE the
           template. `set -a` exports the bare KEY=value assignments to
           the exec'd runner; the `[ -r` guard keeps a missing env file
           from aborting the non-interactive sh (the `-` optional
           semantics); `&&` is XML-escaped as &amp;&amp; in this file. -->
      <string>[ -r '{{ORBI_REPO_DIR}}/.orbi/env' ] &amp;&amp; { set -a; . '{{ORBI_REPO_DIR}}/.orbi/env'; set +a; }; exec '{{ORBI_USER_HOME}}/.local/bin/orbi'</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>ORBI_CONFIG</key>
      <string>{{ORBI_REPO_DIR}}/orbi.toml</string>
      <key>PATH</key>
      <string>{{ORBI_USER_HOME}}/.npm-global/bin:{{ORBI_USER_HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <!-- Runner output lands per instance in the gitignored state dir
         (the journal_lines hook tails exactly this file). -->
    <key>StandardOutPath</key>
    <string>{{ORBI_REPO_DIR}}/.orbi/{{ORBI_LABEL}}.log</string>
    <key>StandardErrorPath</key>
    <string>{{ORBI_REPO_DIR}}/.orbi/{{ORBI_LABEL}}.log</string>
  </dict>
</plist>
