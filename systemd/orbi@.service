[Unit]
Description=Orbi — process one ready GitHub Issue (instance %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Issue #262: the deployment checkout path is NOT hardcoded. The
# {{ORBI_REPO_DIR}} placeholder is substituted at install time by
# `orbi install-units` with the checkout's resolved absolute path, so a
# checkout at ANY location deploys cleanly (the pre-#262 templates
# hardcoded %h/Documents/orbi/orbi, which broke every other layout).
WorkingDirectory={{ORBI_REPO_DIR}}
Environment="PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="ORBI_CONFIG={{ORBI_REPO_DIR}}/orbi.toml"
# Issue #172: the provider file may reference API keys as environment
# variables (e.g. $GROQ_API_KEY). The user-local env file in the
# gitignored state dir (next to base-sync.lock) carries them; the `-`
# prefix keeps deployments without provider files working. The key
# lives only in that local file — never in this template, the repo, or
# the journal.
EnvironmentFile=-{{ORBI_REPO_DIR}}/.orbi/env
# Deployment adapter only: disable systemd's default startup kill limit.
TimeoutStartSec=infinity
# Issue #52/#535: before the Runner starts, the deployment checkout is
# synced OUTSIDE the Python Runner process. Issue #535 replaced the
# hardcoded `git fetch origin main && git merge --ff-only origin/main`
# with the engine source update channel: the second preflight step runs
# `orbi sync-engine-source`, which reads `engine_source_track` from the
# deploy home's orbi.toml and brings the checkout to that channel
# (origin/main by default — the exact pre-#535 behavior — or a branch,
# the newest official release tag, one exact tag, or one exact commit;
# detached HEAD is allowed for locks). A dirty checkout, a failed fetch,
# a missing tag/SHA, a non-fast-forwardable branch or any state that
# cannot be verified against the resolved commit fails this command with
# a structured journal line (deploy_home_dirty / engine_source_*, each
# with a fix): the service does not start. A currently running long task
# is never hot-updated or killed: while the service is active, systemd
# ignores the timer's start request, and the next real start picks up
# the tracked source.
# Issue #149: both instances may start in the same tick, so both
# preflight steps run under a short-lived flock on the shared state-dir
# lock file (the Python-side sync in bootstrap_runner takes the SAME
# lock): the main worktree is never written concurrently.
# Issue #191: disabling fetch's automatic maintenance prevents Git from
# detaching a maintenance child beyond this preflight and flock lifetime
# (engine_source.py passes --no-auto-maintenance to every fetch).
# Issue #861: the reinstall's interpreter follows the SAME compatible
# selection rule as `orbi setup` (cli_source.select_python_interpreter):
# the system `python3` when it satisfies the packaging floor
# (requires-python >= 3.14 — Fedora 43, current Arch), otherwise the
# bare `3.14` so uv provisions or selects a compatible interpreter
# (Ubuntu 24.04 ships Python 3.12). The shell probe is cli_source's
# PYTHON_PROBE_CODE verbatim (pinned by tests); the `$$I` is the
# systemd escape for a literal `$I` the shell expands after the probe.
ExecStartPre=/usr/bin/timeout 300s /usr/bin/flock {{ORBI_REPO_DIR}}/.orbi/base-sync.lock -c 'if python3 -c "import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 14) else 1)" 2>/dev/null; then I=python3; else I=3.14; fi; %h/.local/bin/orbi --version >/dev/null 2>&1 || uv tool install --force --reinstall --editable --python $$I {{ORBI_REPO_DIR}}'
ExecStartPre=/usr/bin/timeout 90s /usr/bin/flock {{ORBI_REPO_DIR}}/.orbi/base-sync.lock -c '%h/.local/bin/orbi sync-engine-source'
# Issue #140: the Runner is the installed `orbi` CLI (the
# uv-tool console script, `uv tool install` / `uv tool upgrade`; the
# executable lands in the user bin dir `~/.local/bin`). The absolute
# entry is verifiable with `systemd-analyze --user verify`. The
# WorkingDirectory stays the deployment checkout: ExecStartPre syncs
# it and the config (orbi.toml) lives there.
ExecStart=%h/.local/bin/orbi
StandardOutput=journal
StandardError=journal
